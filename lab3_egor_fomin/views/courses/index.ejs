<%- include('../partials/header', { title }) %>
<section class="page-heading">
    <div>
        <h1>Учебные курсы</h1>
        <p class="muted">Просматривайте, находите и редактируйте учебные дисциплины.</p>
    </div>
    <a class="button button-primary" href="/courses/new">Добавить курс</a>
</section>

<form class="filters card" action="/courses" method="GET">
    <div class="field">
        <label for="search">Поиск по названию или преподавателю</label>
        <input id="search" name="search" type="search" value="<%= search %>" placeholder="Например, node или Ivan">
    </div>
    <div class="field">
        <label for="semester">Семестр</label>
        <select id="semester" name="semester">
            <option value="">Все семестры</option>
            <% semesters.forEach((number) => { %>
                <option value="<%= number %>" <%= String(semester) === String(number) ? 'selected' : '' %>><%= number %></option>
            <% }) %>
        </select>
    </div>
    <div class="filter-actions">
        <button class="button button-primary" type="submit">Применить</button>
        <a class="button button-secondary" href="/courses">Сбросить</a>
    </div>
</form>

<% if (courses.length === 0) { %>
    <p class="empty-state card">Курсы не найдены</p>
<% } else { %>
    <div class="table-wrap card">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Преподаватель</th>
                    <th>Кредиты</th>
                    <th>Семестр</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                <% courses.forEach((course) => { %>
                    <tr>
                        <td data-label="Название"><strong><%= course.title %></strong></td>
                        <td data-label="Преподаватель"><%= course.teacher %></td>
                        <td data-label="Кредиты"><%= course.credits %></td>
                        <td data-label="Семестр"><%= course.semester %></td>
                        <td data-label="Действия">
                            <div class="actions">
                                <a class="button button-view" href="/courses/<%= course.id %>">Просмотр</a>
                                <a class="button button-edit" href="/courses/<%= course.id %>/edit">Изменить</a>
                                <form action="/courses/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Удалить этот курс?')">
                                    <button class="button button-delete" type="submit">Удалить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>
<%- include('../partials/footer') %>
