<%- include('../partials/header', { title }) %>
<section class="page-heading"><div><p class="eyebrow">Команда</p><h1>Преподаватели</h1></div><% if (currentUser && currentUser.role === 'admin') { %><a class="button button-primary" href="/teachers/new">Добавить преподавателя</a><% } %></section>
<%- include('../partials/errors', { errors }) %>
<% if (teachers.length) { %>
    <div class="table-wrap card"><table>
        <thead><tr><th>Имя</th><th>Email</th><th>Кафедра</th><th>Учёная степень</th><th>Курсы</th><th>Действия</th></tr></thead>
        <tbody><% teachers.forEach((teacher) => { %><tr>
            <td data-label="Имя"><%= teacher.name %></td><td data-label="Email"><%= teacher.email %></td>
            <td data-label="Кафедра"><%= teacher.department %></td><td data-label="Учёная степень"><%= teacher.academicDegree %></td>
            <td data-label="Курсы"><%= teacher.courses.length %></td>
            <td data-label="Действия"><div class="actions">
                <a class="button button-view" href="/teachers/<%= teacher.id %>">Просмотр</a>
                <% if (currentUser && currentUser.role === 'admin') { %>
                    <a class="button button-edit" href="/teachers/<%= teacher.id %>/edit">Изменить</a>
                    <% if (!teacher.courses.length) { %><form action="/teachers/<%= teacher.id %>/delete" method="POST" onsubmit="return confirm('Удалить преподавателя?')"><button class="button button-delete" type="submit">Удалить</button></form><% } else { %><span class="muted">Есть курсы</span><% } %>
                <% } %>
            </div></td>
        </tr><% }) %></tbody>
    </table></div>
<% } else { %><p class="empty-state card">Преподаватели не найдены</p><% } %>
<%- include('../partials/footer') %>
