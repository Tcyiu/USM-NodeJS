<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Учебные курсы</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <a class="brand" href="/courses">Система управления учебными курсами</a>
            <nav aria-label="Основная навигация">
                <a href="/courses">Курсы</a>
                <a href="/teachers">Преподаватели</a>
                <% if (currentUser) { %><a href="/statistics">Статистика</a><a href="/profile">Профиль (<%= currentUser.name %>)</a><% } %>
                <% if (currentUser && currentUser.role === 'admin') { %>
                    <a href="/courses/new">Добавить курс</a>
                    <a href="/teachers/new">Добавить преподавателя</a>
                <% } %>
                <% if (currentUser) { %>
                    <form class="nav-form" action="/logout" method="POST"><button class="nav-button" type="submit">Выход</button></form>
                <% } else { %>
                    <a href="/login">Вход</a>
                    <a href="/register">Регистрация</a>
                <% } %>
            </nav>
        </div>
    </header>
    <main class="container">
        <aside id="notifications" class="notifications" aria-live="polite" aria-label="Уведомления"></aside>
