<%- include('partials/header', { title }) %>
<section class="page-heading"><div><p class="eyebrow">Учётная запись</p><h1>Профиль</h1></div></section>
<section class="course-details card">
    <dl>
        <div><dt>Имя</dt><dd><%= user.name %></dd></div>
        <div><dt>Email</dt><dd><%= user.email %></dd></div>
        <div><dt>Роль</dt><dd><%= user.role %></dd></div>
        <div><dt>Дата регистрации</dt><dd><%= user.createdAt.toLocaleString('ru-RU') %></dd></div>
        <div><dt>Последний вход</dt><dd><%= user.lastLogin ? user.lastLogin.toLocaleString('ru-RU') : 'Ещё не выполнен' %></dd></div>
    </dl>
</section>
<%- include('partials/footer') %>
