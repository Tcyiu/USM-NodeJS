<%- include('../partials/header', { title }) %>
<section class="page-heading">
    <div><p class="eyebrow">Каталог</p><h1>Учебные курсы</h1></div>
    <a class="button button-primary" href="/courses/new">Добавить курс</a>
</section>
<%- include('../partials/errors', { errors }) %>
<form class="filters card" action="/courses" method="GET">
    <div class="field"><label for="search">Поиск по названию</label><input id="search" name="search" type="search" value="<%= search %>" placeholder="Например, Node.js"></div>
    <div class="field">
        <label for="teacherId">Преподаватель</label>
        <select id="teacherId" name="teacherId">
            <option value="">Все преподаватели</option>
            <% teachers.forEach((teacher) => { %><option value="<%= teacher.id %>" <%= String(teacherId) === String(teacher.id) ? 'selected' : '' %>><%= teacher.name %></option><% }) %>
        </select>
    </div>
    <div class="field">
        <label for="semester">Семестр</label>
        <select id="semester" name="semester">
            <option value="">Все семестры</option>
            <% semesters.forEach((number) => { %><option value="<%= number %>" <%= String(semester) === String(number) ? 'selected' : '' %>><%= number %></option><% }) %>
        </select>
    </div>
    <div class="filter-actions"><button class="button button-primary" type="submit">Применить</button><a class="button button-secondary" href="/courses">Сбросить</a></div>
</form>
<% if (courses.length) { %>
    <div class="table-wrap card"><table>
        <thead><tr><th>Название</th><th>Преподаватель</th><th>Кредиты</th><th>Семестр</th><th>Действия</th></tr></thead>
        <tbody><% courses.forEach((course) => { %><tr>
            <td data-label="Название"><%= course.title %></td>
            <td data-label="Преподаватель"><a href="/teachers/<%= course.teacher.id %>"><%= course.teacher.name %></a></td>
            <td data-label="Кредиты"><%= course.credits %></td>
            <td data-label="Семестр"><%= course.semester %></td>
            <td data-label="Действия"><div class="actions">
                <a class="button button-view" href="/courses/<%= course.id %>">Просмотр</a>
                <a class="button button-edit" href="/courses/<%= course.id %>/edit">Изменить</a>
                <form action="/courses/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Вы действительно хотите удалить этот курс?')"><button class="button button-delete" type="submit">Удалить</button></form>
            </div></td>
        </tr><% }) %></tbody>
    </table></div>
<% } else { %><p class="empty-state card">Курсы не найдены</p><% } %>
<%- include('../partials/footer') %>
